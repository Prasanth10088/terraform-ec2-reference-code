resource "aws_security_group" "allow_tls" {
  name        = "allow_tls"
  description = "Allow TLS inbound traffic and all outbound traffic"
  vpc_id      = aws_vpc.my_vpc.id

ingress{
  from_port         = 0
  protocol       = "-1"
  to_port           = 0
}

egress{
 
  from_port         = 0
  protocol       = "-1"
  to_port           = 0
}

}
